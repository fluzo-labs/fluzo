# Grafana admin credentials are generated locally and MUST NOT be
# committed. Copy to observability/.env and replace the password:
#   cp observability/.env.example observability/.env
#   printf "GRAFANA_ADMIN_USER=admin\nGRAFANA_ADMIN_PASSWORD=%s\n" "$(openssl rand -hex 16)" > observability/.env
#
# Rotation: change GRAFANA_ADMIN_PASSWORD in .env, then
#   docker compose -f observability/docker-compose.yml up -d grafana
# (or in the Grafana UI under Server admin > Users). The .env file is
# gitignored; never commit real credentials.

# Host port bindings (loopback only). Change on port conflicts.
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
